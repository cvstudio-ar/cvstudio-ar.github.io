# INACTIVE TEMPLATE. Not read by Actions from this directory/extension.
# Activation requires explicit production approval and a settings review first.
name: CVStudio Worker - producción
on:
  workflow_dispatch:
    inputs:
      confirm_worker:
        description: 'Escribir cvstudio-contacto para autorizar este despliegue'
        required: true
        type: string
permissions:
  contents: read
concurrency:
  group: cvstudio-worker-production
  cancel-in-progress: false
jobs:
  deploy:
    if: github.ref == 'refs/heads/main' && inputs.confirm_worker == 'cvstudio-contacto' && vars.CVSTUDIO_PRODUCTION_DEPLOY_ENABLED == 'true'
    environment: cvstudio-production
    runs-on: ubuntu-latest
    timeout-minutes: 10
    env:
      CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_PRODUCTION_API_TOKEN }}
      CLOUDFLARE_ACCOUNT_ID: ${{ vars.CLOUDFLARE_ACCOUNT_ID }}
      WRANGLER_SEND_METRICS: 'false'
      CVSTUDIO_PRODUCTION_APPROVED_SHA: ${{ vars.CVSTUDIO_PRODUCTION_APPROVED_SHA }}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
        with:
          node-version: '22'
      - run: npm ci --prefix deployment
      - run: node --test tests/marketing-*.test.cjs
      - name: Verificar configuración de producción revisada
        run: node scripts/deploy/production-preflight.mjs
      - run: deployment/node_modules/.bin/wrangler deploy --dry-run --config deployment/wrangler.production.json
      - run: deployment/node_modules/.bin/wrangler deploy --keep-vars --config deployment/wrangler.production.json

