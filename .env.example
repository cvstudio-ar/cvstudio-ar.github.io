# Este archivo solo documenta los nombres de configuración.
# No colocar valores reales ni subir secretos al repositorio.

# Frontend público (usar en js/supabase-config.js o futura configuración)
CVSTUDIO_SUPABASE_URL=
CVSTUDIO_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Worker Secrets (configurar en Cloudflare, nunca en frontend)
RESEND_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_WEBHOOK_SECRET=

# Variable opcional del Worker
RESEND_RECEIVING_DOMAIN=iokioalkuu.resend.app

# Mercado Pago (cargar como Secret únicamente en Cloudflare; no usar en GitHub Pages)
MERCADOPAGO_ACCESS_TOKEN=

# Canva Connect API OAuth (cargar como Secrets únicamente en Cloudflare)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Destinatario de los formularios completados
